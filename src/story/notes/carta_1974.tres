[gd_resource type="Resource" script_class="NoteData" format=3]

[ext_resource type="Script" path="res://src/story/note_data.gd" id="1_note"]

[resource]
script = ExtResource("1_note")
id = "carta_1974"
title = "Carta sin enviar"
signature = "Severino M., agosto de 1974"
body = "Querida Justina:

Hoy encontramos plata como nunca vi. Los viejos dicen que es la veta del Tío y que hay que pagarle con más que coca. El capataz se rió y dijo que eso es cuento.

Desde entonces la lámpara se me apaga sola cuando bajo. Si no vuelvo para la fiesta, no me esperes en la bocamina. Búscame en el salar, donde el cielo se mira en el agua."
