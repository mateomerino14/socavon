[resource]
script = ExtResource("1_note")
id = "lista_raya"
title = "Lista de raya"
signature = "Cooperativa Cerro Rico, quincena de marzo de 1975"
body = "Cuadrilla del nivel cerrado:

Severino Mamani ..... no cobró
Justo Condori ....... no cobró
Efraín Choque ....... no cobró
Teodoro Quispe ...... no cobró
Nicanor Flores ...... no cobró
Basilio Huanca ...... no cobró
Agustín Copa ........ no cobró

Guardar los sobres en caja. Que nadie los reclame por ellos."
