[gd_resource type="Resource" script_class="NoteData" format=3]

[ext_resource type="Script" path="res://src/story/note_data.gd" id="1_note"]

[resource]
script = ExtResource("1_note")
id = "plano_gateaderos"
title = "Plano a lápiz"
signature = "Ing. R. Salinas"
body = "Galería de la veta. Ventilación por el norte.

Los gateaderos del oeste son demasiado bajos para los carros. Los obreros dicen que también para \"él\", y por eso se meten ahí a descansar.

Pasar agachado. No llevar nada que haga ruido."
