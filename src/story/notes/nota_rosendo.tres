[gd_resource type="Resource" script_class="NoteData" format=3]

[ext_resource type="Script" path="res://src/story/note_data.gd" id="1_note"]

[resource]
script = ExtResource("1_note")
id = "nota_rosendo"
title = "Pañuelo con letras de carbón"
signature = "R."
body = "Chango:

Faustino le habló al Tío. Le ofreció a uno de nosotros para salir él.

Yo no voy a ser. Me escondo hasta que pase.

Si llegas a la bocamina, paga tú, con lo que tengas, pero paga. Coca, trago y cigarro: así se le pagaba antes."
