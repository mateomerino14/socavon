[gd_resource type="Resource" script_class="NoteData" format=3]

[ext_resource type="Script" path="res://src/story/note_data.gd" id="1_note"]

[resource]
script = ExtResource("1_note")
id = "nota_rosendo"
title = "Pañuelo con letras de carbón"
signature = "R."
body = "Chango:

Faustino le habló al Tío y le ofreció a uno de nosotros a cambio de salir él. Yo no pienso ser ese, así que me voy a esconder hasta que todo esto pase.

Si llegas a la bocamina, págale tú con lo que tengas, pero págale. Coca, trago y cigarro, así se le pagaba antes, y así es como él se acuerda."
