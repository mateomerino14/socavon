transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -35.5)
ending_screen = NodePath("../EndingScreen")
restart_scene_path = "res://src/world/level_01/level_01.tscn"
paid_title = "Con permiso"
paid_body = "Le pagaste lo que se le debía y, al salir, el sol de Potosí te quema los ojos como si fuera la primera vez que lo ves.

Detrás de ti, en la oscuridad del socavón, alguien sopla despacio el humo de tu cigarro. Esta vez el Tío te dejó ir, pero ya sabes que nunca más hay que entrar sin ch'alla."
unpaid_title = "Sin permiso"
unpaid_body = "Saliste sin pagar, y arriba nadie te reconoce. En la cooperativa cuentan que el chango Mateo nunca volvió del nivel cerrado.

Esa noche, los mineros del turno oyen golpes en la roca y una voz joven que los llama por su nombre desde abajo. La cuadrilla del Tío, por fin, está completa."

